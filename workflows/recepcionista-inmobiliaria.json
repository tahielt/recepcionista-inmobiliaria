      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (session_id, ia_activa, updated_at) VALUES ($1, $2, now()) ON CONFLICT (session_id) DO UPDATE SET ia_activa = EXCLUDED.ia_activa, updated_at = now();",
