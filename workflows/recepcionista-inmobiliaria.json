    {
      "id": "tool_buscar",
      "name": "buscar_propiedades",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
      "position": [
        1500,
        920
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Busca propiedades reales del catálogo por operación (venta/alquiler), zona y presupuesto máximo en USD. Usala SIEMPRE antes de mencionar cualquier propiedad, precio o link.",
        "operation": "executeQuery",
        "query": "SELECT codigo, titulo, operacion, tipo, zona, ambientes, dormitorios, precio_usd, unidad_precio, url_ficha FROM propiedades WHERE activa AND ($1 = '' OR operacion = $1) AND ($2 = '' OR zona ILIKE '%' || $2 || '%') AND ($3 = 0 OR precio_usd <= $3) ORDER BY destacada DESC, precio_usd ASC LIMIT 3;",
        "options": {
          "queryReplacement": "={{ [$fromAI('operacion', \"'venta' o 'alquiler'; vacío si no sabe\", 'string'), $fromAI('zona','barrio/zona de Bariloche; vacío si no sabe','string'), $fromAI('presupuesto_usd','presupuesto máximo en USD; 0 si no sabe','number')] }}"
        }
      }
    },
    {
      "id": "tool_guardar",
      "name": "guardar_precalificacion",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
      "position": [
        1660,
        920
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Guarda/actualiza lo que sabés del lead: operación (venta/alquiler), zona, presupuesto USD, ambientes, forma de pago y urgencia. No pidas el session_id: lo pone el sistema.",
        "operation": "executeQuery",
        "query": "INSERT INTO leads (session_id, operacion, zona, presupuesto_usd, ambientes, forma_pago, urgencia, updated_at) VALUES ($1, NULLIF($2,''), NULLIF($3,''), NULLIF($4,0), NULLIF($5,0), NULLIF($6,''), NULLIF($7,''), now()) ON CONFLICT (session_id) DO UPDATE SET operacion=COALESCE(EXCLUDED.operacion, leads.operacion), zona=COALESCE(EXCLUDED.zona, leads.zona), presupuesto_usd=COALESCE(EXCLUDED.presupuesto_usd, leads.presupuesto_usd), ambientes=COALESCE(EXCLUDED.ambientes, leads.ambientes), forma_pago=COALESCE(EXCLUDED.forma_pago, leads.forma_pago), urgencia=COALESCE(EXCLUDED.urgencia, leads.urgencia), updated_at=now();",
        "options": {
          "queryReplacement": "={{ [$('Normalizar entrada').item.json.session_id, $fromAI('operacion','venta o alquiler; vacío si no sabe','string'), $fromAI('zona','zona; vacío si no sabe','string'), $fromAI('presupuesto_usd','USD; 0 si no sabe','number'), $fromAI('ambientes','cantidad; 0 si no sabe','number'), $fromAI('forma_pago','contado/crédito/permuta; vacío si no sabe','string'), $fromAI('urgencia','alta/media/baja; vacío si no sabe','string')] }}"
        }
      }
    },
    {
      "id": "verif",
      "name": "Verificador anti-alucinación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        700
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Patrón 4: ningún precio ni link puede salir si no está respaldado por una tool de ESTE turno.\nconst out = $json.output ?? $json.text ?? '';\nconst steps = $json.intermediateSteps ?? [];\nconst evidencia = JSON.stringify(steps);\nconst soloDigitos = (s) => (s || '').replace(/[^0-9]/g, '');\nconst evidenciaDigitos = soloDigitos(evidencia);\n\nconst precioRe = /(?:usd|u\\$s|us\\$|\\$)\\s*([0-9][0-9.,]{2,})/gi;\nconst linkRe = /https?:\\/\\/[^\\s)]+/gi;\n\nconst noRespaldados = [];\nlet m;\nwhile ((m = precioRe.exec(out)) !== null) {\n  const d = soloDigitos(m[1]);\n  if (d.length >= 3 && !evidenciaDigitos.includes(d)) noRespaldados.push('precio ' + m[0].trim());\n}\nfor (const l of (out.match(linkRe) || [])) {\n  if (!evidencia.includes(l)) noRespaldados.push('link ' + l);\n}\n\nconst hardFail = noRespaldados.length > 0;\nreturn {\n  session_id: $('Normalizar entrada').item.json.session_id,\n  hardFail,\n  motivo: hardFail ? ('Datos sin respaldo del catálogo: ' + noRespaldados.join('; ')) : '',\n  mensaje: hardFail\n    ? 'Disculpá, prefiero no pasarte un dato sin confirmarlo. Ya le aviso a un asesor para que te responda esto a la brevedad 🙏'\n    : out,\n  nota_equipo: hardFail ? ('⚠️ Verificador bloqueó la respuesta. ' + noRespaldados.join('; ')) : ''\n};"
      }
    },
    {
      "id": "if_der",
      "name": "¿Derivar o hardFail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1840,
        700
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cd1",
              "leftValue": "={{ $json.hardFail }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cd2",
              "leftValue": "={{ $('Normalizar entrada').item.json.texto }}",
              "rightValue": "asesor|humano|visita|visitar|oferta|reservar",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
      "id": "pg_nota",
      "name": "Nota al equipo + pausa",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2060,
        560
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO eventos_equipo (session_id, tipo, detalle) VALUES ($1, $2, $3); UPDATE leads SET ia_activa = false, derivado = true, updated_at = now() WHERE session_id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.session_id, ($json.hardFail ? 'hard_fail' : 'derivacion'), ($json.motivo || 'Derivación por intención del cliente (visita/oferta/asesor)')] }}"
        }
      }
    },
    {
      "id": "code_split",
      "name": "Partir en mensajes (≤250)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        820
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Patrón 3: partir la respuesta en mensajes de <=250 caracteres.\nconst src = $('Verificador anti-alucinación').first().json;\nconst msg = (src.mensaje ?? '').trim();\nconst session_id = src.session_id;\nconst partes = [];\nlet resto = msg;\nwhile (resto.length > 250) {\n  let corte = resto.lastIndexOf(' ', 250);\n  if (corte < 100) corte = 250;\n  partes.push(resto.slice(0, corte).trim());\n  resto = resto.slice(corte).trim();\n}\nif (resto) partes.push(resto);\nreturn partes.map((p, i) => ({ json: { session_id, parte: p, idx: i + 1, total: partes.length } }));"
      }
    },
