# npm run instalar crea .env desde este archivo y genera los secretos. El .env NO se sube al repo.
# Si lo armás a mano: openssl rand -hex 32 para cada secreto (uno distinto para cada uno).

# ── Secretos del stack ───────────────────────────────────────────────────────
# Usuario y clave del Postgres único (bases n8n, inmo, chatwoot y evolution).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Clave de Redis (Chatwoot usa la base 0, el flujo de n8n la 1 y Evolution la 6).
REDIS_PASSWORD=
# Encripta las credenciales guardadas en n8n. Si la perdés, hay que recargarlas.
N8N_ENCRYPTION_KEY=
# Secreto compartido entre n8n y su task runner (nodos Code).
N8N_RUNNERS_AUTH_TOKEN=
# Firma las cookies de Chatwoot.
CHATWOOT_SECRET_KEY_BASE=
# API key global de Evolution (header "apikey" en su API).
EVOLUTION_API_KEY=

# ── Los 2 tokens que se pegan a mano (npm run instalar te avisa cuándo) ──────
# Chatwoot → tu perfil → Access Token (después de crear el admin en http://localhost:3000).
CHATWOOT_API_TOKEN=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Nombre de la instancia de WhatsApp en Evolution (y del inbox que crea en Chatwoot).
EVOLUTION_INSTANCIA=inmobiliaria

# ── URLs públicas ────────────────────────────────────────────────────────────
# En local quedan en localhost. Con dominio y túnel: https://chat.tudominio.com y https://n8n.tudominio.com
CHATWOOT_URL_PUBLICA=http://localhost:3000
N8N_URL_PUBLICA=http://localhost:5678
# URL con la que Chatwoot le habla a Evolution. Por la red interna de Docker no hace falta cambiarla.
EVOLUTION_URL=http://evolution:8080

# ── Túnel de Cloudflare (opcional) ───────────────────────────────────────────
# Token del túnel creado en Cloudflare Zero Trust → Networks → Tunnels (perfil "tunel").
# Sin dominio, usá el perfil "tunel-rapido": no necesita token.
CLOUDFLARE_TUNNEL_TOKEN=
# Con el token cargado, descomentá esto para que docker compose (y npm run instalar) levanten el túnel.
# COMPOSE_PROFILES=tunel

# ── Versiones (fijas; se actualizan a mano, ver docs) ────────────────────────
N8N_VERSION=2.46.4
CHATWOOT_VERSION=v4.19.1
EVOLUTION_VERSION=v2.3.7
CLOUDFLARED_VERSION=2026.10.7

# ── Otros ────────────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
# Puerto de Postgres en la PC (127.0.0.1), para npm run importar. 5433 para no chocar con el del test.
POSTGRES_PUERTO=5433
# Hilos de Sidekiq de Chatwoot. 5 alcanza para 10 inmobiliarias y ahorra RAM.
CHATWOOT_SIDEKIQ_CONCURRENCY=5
